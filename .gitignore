# ── Zależności ────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log
yarn-error.log

# ── Build output (generowany przez CI — nie commitować) ───────────────────────
frontend/dist/
backend/dist/

# ── Środowisko lokalne (NIE produkcja) ────────────────────────────────────────
.env
.env.local
.env.*.local
# .env.production jest OK do commita (nie zawiera sekretów)

# ── Sekrety — NIGDY do Git ────────────────────────────────────────────────────
serviceAccountKey.json
backend/.env
secret/

# ── Notatki projektowe (prywatne) ─────────────────────────────────────────────
notatki.md
info.md

# ── IDE / System ──────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.claude

# ── Zbędny root package (pozostałość po npm install w root) ───────────────────
/package-lock.json
/package.json

# ── Logi ──────────────────────────────────────────────────────────────────────
logs/
*.log
